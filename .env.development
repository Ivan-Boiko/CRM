# Локальная разработка: клиент на порту 3000, сервер на порту 5000.
# В production этот файл не используется — там клиент ходит на свой же домен.
REACT_APP_API_URL=http://localhost:5000

# Проверка с телефона по локальной сети: «localhost» на телефоне — это сам телефон,
# поэтому создайте рядом .env.development.local (он в .gitignore) с IP компьютера:
#   REACT_APP_API_URL=http://192.168.1.10:5000
# IP узнать: ipconfig (Windows) или ifconfig / ip addr (macOS, Linux).
