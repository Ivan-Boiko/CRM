# Скопируйте этот файл в .env и заполните своими значениями:
#   cp .env.example .env
# .env не попадает в git — там настоящие секреты.

# --- Домен ---
# Домен, на который указывает A-запись. Caddy выпустит для него HTTPS-сертификат.
DOMAIN=crm.example.com

# --- Приложение ---
# Порт внутри контейнера (наружу его не публикуем, доступ только через Caddy)
PORT=5000

# Секрет для JWT. Обязателен в production: сгенерируйте `openssl rand -hex 32`.
# Если поменять секрет, все текущие сессии станут недействительными.
JWT_SECRET=change-me-openssl-rand-hex-32

# Файл базы SQLite. В docker это том /data, поэтому база переживает пересборки.
DB_PATH=/data/crm.db

# Откуда разрешены запросы к API — через запятую, без слэша на конце.
# Для работы через Caddy достаточно своего домена:
CORS_ORIGINS=https://crm.example.com

# Где Express ищет собранный React (в образе это /app/build)
CLIENT_BUILD_DIR=/app/build

# Защита от подбора пароля: сколько неудачных попыток на «IP + email» разрешено
# и за какое окно в минутах. После лимита вход отвечает 429 до конца окна.
LOGIN_MAX_ATTEMPTS=5
# Общий лимит на один IP: чтобы нельзя было перебирать сразу много аккаунтов
LOGIN_MAX_ATTEMPTS_IP=20
LOGIN_WINDOW_MINUTES=15

# Регистрация новых пользователей. Создайте свой аккаунт, затем поставьте false,
# иначе зарегистрироваться сможет любой, кто знает адрес. Кнопка на странице входа
# исчезнет, а POST /api/register будет отвечать 403.
ALLOW_REGISTRATION=true

# --- Telegram (необязательно) ---
# Токен личного бота от @BotFather (/newbot). Если оставить пустым, подключение
# Telegram в настройках будет выключено, остальное приложение работает как обычно.
# После изменения перезапустите контейнер: docker compose up -d
TELEGRAM_BOT_TOKEN=

# --- Письма и сброс пароля (необязательно) ---
# Публичный адрес приложения: из него собирается ссылка в письме.
# Без него в production ссылка сброса пароля будет неверной.
APP_ORIGIN=https://crm.example.com
# Ключ Resend (https://resend.com/api-keys). Отправка идёт обычным HTTPS-запросом,
# без SDK. Без ключа кнопка «Забыли пароль?» отвечает 503, остальное работает.
RESEND_API_KEY=
# Отправитель. onboarding@resend.dev работает только для писем на свой аккаунт
# Resend; для реальных адресов подключите свой домен в Resend.
MAIL_FROM=CRM <onboarding@resend.dev>

# --- Бэкапы (необязательно) ---
# Куда складывать копии базы и сколько последних хранить
# BACKUP_DIR=/data/backups
# BACKUP_KEEP=14
